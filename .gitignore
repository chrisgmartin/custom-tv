.DS_Store
build/

# Personal overrides for the template config, loaded after js/config.js if present.
js/config.local.js

# Signing material and SDK installers kept beside the repo (never redistribute).
tizencertificates/
web-cli_Tizen_SDK_*.bin

# Signing material: never commit certificates, passwords or Tizen profiles.
*.p12
*.pwd
*.cer
*.env
profiles.xml
.signing/

# Compiled TV helpers; rebuild with tools/build-helpers.sh.
bin/
obj/
tools/home-routing/out/
tools/notification-settings/out/
tools/vendor/samsung-tv-root/samsung_tv_root/payloads/
__pycache__/
*.pyc

# Backups and captures from your own TV.
backup-*/
screenshots/
# README images live under docs/screenshots and should be committed.
!docs/screenshots/
!docs/screenshots/**
*.tgz
*.db
*.db-journal
/.local/
/experiments/
